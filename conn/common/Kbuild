# wmt_drv for MT6833 (CONSYS + MT6631 A-die) on the a22x mainline kernel
MODULE_NAME := wmt_drv
obj-m += $(MODULE_NAME).o

ccflags-y += -DCONFIG_MTK_WCN_ARM64 -DWMT_IDC_SUPPORT=0
ccflags-y += -DMTK_WCN_WMT_STP_EXP_SYMBOL_ABSTRACT
ccflags-y += -DCONSYS_PMIC_CTRL_6635=0 -DALLOCATE_CONNSYS_EMI_FROM_KO
ccflags-y += -DWMT_PLAT_ALPS=1 -DWMT_UART_RX_MODE_WORK=0 -DWMT_SDIO_MODE=1
ccflags-y += -DWMT_CREATE_NODE_DYNAMIC=1 -DWMT_DBG_SUPPORT=1 -DWMT_DEVAPC_DBG_SUPPORT=0
ccflags-y += -DCONFIG_MTK_CONNSYS_DEDICATED_LOG_PATH=1
ccflags-y += -I$(src)/../btif/common/inc
ccflags-y += -I$(src)/common_main/linux/include -I$(src)/common_main/linux/pri/include
ccflags-y += -I$(src)/common_main/platform/include -I$(src)/common_main/core/include
ccflags-y += -I$(src)/common_main/include
ccflags-y += -I$(src)/common_detect/drv_init/inc -I$(src)/common_detect
ccflags-y += -I$(src)/debug_utility

$(MODULE_NAME)-objs += common_detect/wmt_detect_pwr.o common_detect/wmt_detect.o
$(MODULE_NAME)-objs += common_detect/sdio_detect.o common_detect/mtk_wcn_stub_alps.o
$(MODULE_NAME)-objs += common_detect/wmt_gpio.o
$(MODULE_NAME)-objs += common_detect/drv_init/fm_drv_init.o common_detect/drv_init/conn_drv_init.o
$(MODULE_NAME)-objs += common_detect/drv_init/bluetooth_drv_init.o common_detect/drv_init/wlan_drv_init.o
$(MODULE_NAME)-objs += common_detect/drv_init/common_drv_init.o common_detect/drv_init/gps_drv_init.o

$(MODULE_NAME)-objs += common_main/platform/mt6833.o common_main/platform/mt6833_dbg.o
$(MODULE_NAME)-objs += common_main/platform/wmt_plat_alps.o common_main/platform/mtk_wcn_consys_hw.o
$(MODULE_NAME)-objs += common_main/platform/mtk_wcn_dump_util.o common_main/platform/mtk_wcn_cmb_hw.o

$(MODULE_NAME)-objs += $(addprefix common_main/core/, wmt_ic_6628.o wmt_conf.o stp_core.o \
	wmt_ctrl.o wmt_func.o wmt_core.o psm_core.o wmt_ic_soc.o wmt_lib.o wmt_ic_6620.o \
	stp_exp.o wmt_ic_6632.o wmt_exp.o btm_core.o wmt_ic_6630.o)
$(MODULE_NAME)-objs += $(addprefix common_main/linux/, hif_sdio.o stp_dbg_soc.o stp_dbg_combo.o \
	osal.o wmt_dev.o stp_sdio.o bgw_desense.o wmt_idc.o wmt_dbg.o stp_dbg.o \
	wmt_user_proc.o wmt_proc_dbg.o wmt_alarm.o fw_log_wmt.o stp_btif.o)
$(MODULE_NAME)-objs += wmt_build_in_adapter.o
$(MODULE_NAME)-objs += a22x_adapter.o
$(MODULE_NAME)-objs += debug_utility/ring.o debug_utility/ring_emi.o debug_utility/connsys_debug_utility.o
