# SPDX-License-Identifier: MIT
# Development prerequisite fragment for A22x mainline recovery.
# Not applied to kernel #107; not a working Android-decrypt implementation.
# Validate against the exact #107 source with an isolated O= build directory.
#
# Generic fscrypt and preservation of filesystem security xattrs.
CONFIG_KEYS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y
#
# Loop devices and COW snapshots for isolated test copies, not automatic
# remapping or restoration of the physical userdata partition.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
#
# Deliberately absent: CONFIG_DM_DEFAULT_KEY and CONFIG_TZDEV.
# The inspected mainline source does not provide these Samsung/Android
# components. Setting an unknown Kconfig symbol would not implement them.
# Generic CONFIG_TEE/CONFIG_OPTEE is not a Samsung TEEGRIS transport.
# Android Binder/HIDL/Bionic, Keymaster/Gatekeeper/keystore2/vold integration,
# trusted boot state, and actual key installation remain separate work.
