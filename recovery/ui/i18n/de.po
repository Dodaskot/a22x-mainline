msgid "Use 2 to 40 letters, digits, + . _ or -."
msgstr "2 bis 40 Buchstaben, Ziffern, + . _ oder - verwenden."

msgid "Use at least 4 characters"
msgstr "Mindestens 4 Zeichen verwenden"

