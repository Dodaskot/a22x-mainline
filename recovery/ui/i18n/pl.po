msgstr "Userdata nie było w nowym spisie woluminów. Odśwież, zanim przejdziesz dalej."

msgid "Userdata wiped"
msgstr "Userdata wyczyszczono"

msgid "userdata, cache or an SD card, in Files"
msgstr "userdata, cache albo karta SD, w Plikach"

