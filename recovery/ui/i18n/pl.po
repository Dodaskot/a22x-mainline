msgstr "Ten obraz jest już na partycji. Nie ma czego wgrywać."

msgid "This image keeps its system on btrfs, which this recovery cannot read"
msgstr "Ten obraz trzyma system na btrfs, którego to recovery nie odczyta"

msgid "This image keeps its system on xfs, which this recovery cannot read"
msgstr "Ten obraz trzyma system na xfs, którego to recovery nie odczyta"

