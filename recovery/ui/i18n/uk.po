msgid "Use 2 to 40 letters, digits, + . _ or -."
msgstr "Використовуйте від 2 до 40 літер, цифр, + . _ або -."

msgid "Use at least 4 characters"
msgstr "Використайте щонайменше 4 символи"

msgid "Use exactly four octal digits, for example 0644 or 0755."
msgstr "Використовуйте рівно чотири вісімкові цифри, наприклад 0644 або 0755."

