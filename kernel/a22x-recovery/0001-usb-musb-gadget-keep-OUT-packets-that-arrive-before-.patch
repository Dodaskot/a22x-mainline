 	usb_gadget_giveback_request(&req->ep->end_point, &req->request);
 	spin_lock(&musb->lock);
 	ep->busy = busy;
+	/* A callback may have queued the next OUT request while busy was set. */
+	if (!ep->busy && ep->desc && !ep->is_in && next_request(ep))
+		musb_g_rx_kick(musb);
 }
 
