--- /dev/null
+++ b/drivers/gpu/drm/mediatek/mtk_boot_splash.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MTK_BOOT_SPLASH_H
