From 75bd4b80ecdc83bba36f755d959cd3ccfc9612ef Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Tue, 10 Nov 2026 06:17:01 +0100
Subject: [PATCH 05/12] drm/mediatek: draw the A22x recovery boot splash

Draw the recovery logo and a progress bar straight into the fbdev
buffer as soon as it exists, which is before /init runs. Plymouth does
the same from userspace but needs a much larger initramfs and starts
later.

The picture is the one the recovery interface draws at startup. The
interface reads boot_splash_percent, writes boot_splash_stop and carries
the bar on to 100%. Selected by CONFIG_DRM_MEDIATEK_BOOT_SPLASH.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/mediatek/Kconfig              |     7 +
 drivers/gpu/drm/mediatek/Makefile             |     2 +
 drivers/gpu/drm/mediatek/mtk_boot_splash.c    |   146 +
 drivers/gpu/drm/mediatek/mtk_boot_splash.h    |    13 +
 .../gpu/drm/mediatek/mtk_boot_splash_logo.h   | 32189 ++++++++++++++++
 drivers/gpu/drm/mediatek/mtk_drm_drv.c        |     2 +
 6 files changed, 32359 insertions(+)
 create mode 100644 drivers/gpu/drm/mediatek/mtk_boot_splash.c
 create mode 100644 drivers/gpu/drm/mediatek/mtk_boot_splash.h
 create mode 100644 drivers/gpu/drm/mediatek/mtk_boot_splash_logo.h

diff --git a/drivers/gpu/drm/mediatek/Kconfig b/drivers/gpu/drm/mediatek/Kconfig
index ad8c8b823681..b83567cfddc6 100644
--- a/drivers/gpu/drm/mediatek/Kconfig
+++ b/drivers/gpu/drm/mediatek/Kconfig
@@ -21,6 +21,13 @@ config DRM_MEDIATEK
 	  This driver provides kernel mode setting and
 	  buffer management to userspace.
 
+config DRM_MEDIATEK_BOOT_SPLASH
+	bool "Boot logo and progress bar for the A22x recovery"
+	depends on DRM_MEDIATEK && DRM_FBDEV_EMULATION
+	help
+	  Draw the recovery logo and a progress bar into the fbdev buffer as
+	  soon as it exists, until userspace takes the screen over.
+
 config DRM_MEDIATEK_DP
 	tristate "DRM DPTX Support for MediaTek SoCs"
 	depends on DRM_MEDIATEK
