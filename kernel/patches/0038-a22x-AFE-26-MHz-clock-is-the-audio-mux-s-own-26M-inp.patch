From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 18:42:43 +0200
Subject: [PATCH 038/131] a22x: AFE 26 MHz clock is the audio mux's own 26M
 input

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index eaf215730..50958f3d0 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -1307,7 +1307,7 @@ afe_ml: audio-controller {
 				 <&topckgen CLK_TOP_APLL12_CK_DIV6>,
 				 <&topckgen CLK_TOP_APLL12_CK_DIV7>,
 				 <&topckgen CLK_TOP_AUDIO_H_SEL>,
-				 <&clk26m>;
+				 <&topckgen CLK_TOP_TCK_26M_MX9>;
 			clock-names = "aud_afe_clk", "aud_dac_clk",
 				      "aud_dac_predis_clk", "aud_adc_clk",
 				      "aud_adda6_adc_clk", "aud_apll22m_clk",
