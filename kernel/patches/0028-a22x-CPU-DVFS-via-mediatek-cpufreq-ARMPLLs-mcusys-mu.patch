+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -384,6 +384,45 @@ mt6359_vproc1_buck_reg: buck_vproc1 {
 					regulator-enable-ramp-delay = <200>;
 				};
 
+				/*
+				 * CPU rails (vendor kernel: big = vgpu11 +
+				 * vsram_proc1, LITTLE + CCI = vproc2 +
+				 * vsram_proc2). Never switched off; the
+				 * ranges cover the bootloader setting so
+				 * nothing changes until cpufreq asks.
