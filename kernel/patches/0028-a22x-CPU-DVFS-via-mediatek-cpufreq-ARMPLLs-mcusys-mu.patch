+/*
+ * CPU DVFS: Linux retunes the cluster PLLs itself (mediatek-cpufreq) instead
+ * of the vendor CPUHVFS/MCUPM path. Tables are the vendor B20G level that
+ * this device is built for (MTK_5GCM_PROJECT), with the unadjusted (pre-EEM)
+ * voltages. LITTLE stops at 950 MHz / 0.725 V because the CCI (675 MHz,
+ * needs 0.725 V) shares Vproc2 and is not scaled yet.
+ */
+/ {
+	mcusys: syscon@c53a000 {
+		compatible = "mediatek,mt6833-mcusys", "syscon";
+		reg = <0 0x0c53a000 0 0x1000>;
+		#clock-cells = <1>;
+	};
+
+	cluster0_opp: opp-table-cluster0 {
+		compatible = "operating-points-v2";
+		opp-shared;
