 include/dt-bindings/clock/mt6833-clk.h        |   6 +
 7 files changed, 361 insertions(+), 1 deletion(-)
 create mode 100644 drivers/clk/mediatek/clk-mt6833-mcu.c

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
