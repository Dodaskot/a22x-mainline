From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 10:36:10 +0200
Subject: [PATCH 017/131] a22x: I2C5 with MT6360 ADC, MT6833 imp_iic_wrap
 clocks; quiet Himax logs

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts |  48 ++++++++
 drivers/clk/mediatek/Makefile                 |   3 +-
 .../clk/mediatek/clk-mt6833-imp_iic_wrap.c    | 105 ++++++++++++++++++
 .../himax_hx83112f/himax_platform.h           |   2 +-
 4 files changed, 156 insertions(+), 2 deletions(-)
 create mode 100644 drivers/clk/mediatek/clk-mt6833-imp_iic_wrap.c

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 3b35b4130..be2ece14b 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -94,6 +94,13 @@ pins-reset {
 			};
 		};
 
+		i2c5_pins: i2c5-pins {
+			pins-bus {
+				pinmux = <PINMUX_GPIO107__FUNC_SCL5>,
+					 <PINMUX_GPIO108__FUNC_SDA5>;
+			};
+		};
+
 		mmc0_pins: mmc0-pins {
 			pins-bus {
 				pinmux = <PINMUX_GPIO65__FUNC_MSDC0_DSL>,
@@ -236,3 +243,44 @@ &topckgen {
 &infracfg_ao {
 	status = "okay";
 };
+
+&imp_iic_wrap_w {
+	status = "okay";
+};
+
+/ {
+	/*
+	 * I2C5 with the MT6360 sub-PMIC (charger, ADC, LDOs, Type-C). A separate
+	 * node from the stock "i2c5": LK's dtbo overlay rewrites the children of
+	 * the stock one with downstream compatibles. The stock node stays off.
+	 */
+	i2c5_ml: i2c@11e01000 {
+		compatible = "mediatek,mt6833-i2c", "mediatek,mt8192-i2c";
+		reg = <0 0x11e01000 0 0x1000>,
+		      <0 0x10217500 0 0x80>;
+		interrupts = <0 117 4>;
+		clocks = <&imp_iic_wrap_w CLK_IMPW_AP_CLOCK_RO_I2C5>,
+			 <&infracfg_ao CLK_IFRAO_AP_DMA>;
+		clock-names = "main", "dma";
+		clock-div = <1>;
+		clock-frequency = <400000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&i2c5_pins>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		mt6360: pmic@34 {
+			compatible = "mediatek,mt6360";
+			reg = <0x34>;
+			interrupts-extended = <&pio_ml 10 IRQ_TYPE_EDGE_FALLING>;
+			interrupt-names = "IRQB";
+			interrupt-controller;
+			#interrupt-cells = <1>;
+
+			mt6360_adc: adc {
+				compatible = "mediatek,mt6360-adc";
+				#io-channel-cells = <1>;
+			};
+		};
+	};
+};
diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index 7d970100f..40a8469c6 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
@@ -123,7 +123,8 @@ obj-$(CONFIG_COMMON_CLK_MT8188_VDOSYS) += clk-mt8188-vdo0.o clk-mt8188-vdo1.o
 obj-$(CONFIG_COMMON_CLK_MT8188_VENCSYS) += clk-mt8188-venc.o
 obj-$(CONFIG_COMMON_CLK_MT8188_VPPSYS) += clk-mt8188-vpp0.o clk-mt8188-vpp1.o
 obj-$(CONFIG_COMMON_CLK_MT8188_WPESYS) += clk-mt8188-wpe.o
-obj-$(CONFIG_COMMON_CLK_MT6833) += clk-mt6833-apmixedsys.o clk-mt6833.o
+obj-$(CONFIG_COMMON_CLK_MT6833) += clk-mt6833-apmixedsys.o clk-mt6833.o \
+				   clk-mt6833-imp_iic_wrap.o
 obj-$(CONFIG_COMMON_CLK_MT8192) += clk-mt8192-apmixedsys.o clk-mt8192.o
 obj-$(CONFIG_COMMON_CLK_MT8192_AUDSYS) += clk-mt8192-aud.o
 obj-$(CONFIG_COMMON_CLK_MT8192_CAMSYS) += clk-mt8192-cam.o
diff --git a/drivers/clk/mediatek/clk-mt6833-imp_iic_wrap.c b/drivers/clk/mediatek/clk-mt6833-imp_iic_wrap.c
new file mode 100644
index 000000000..b18dcc3ac
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6833-imp_iic_wrap.c
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6833 IMP_IIC_WRAP (I2C wrapper) clock gates.
+ * Gate tables from the Samsung SM-A226B (MT6833) kernel source.
+ */
+#include <dt-bindings/clock/mt6833-clk.h>
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+static const struct mtk_gate_regs imp_iic_wrap_cg_regs = {
+	.set_ofs = 0xe08,
+	.clr_ofs = 0xe04,
+	.sta_ofs = 0xe00,
+};
+
+#define GATE_IMP_IIC_WRAP(_id, _name, _parent, _shift)			\
+	GATE_MTK_FLAGS(_id, _name, _parent, &imp_iic_wrap_cg_regs, _shift,	\
+		&mtk_clk_gate_ops_setclr, CLK_OPS_PARENT_ENABLE)
+
+static const struct mtk_gate imp_iic_wrap_c_clks[] = {
+	GATE_IMP_IIC_WRAP(CLK_IMPC_AP_CLOCK_RO_I2C10, "impc_ap_i2c10", "i2c_pseudo", 0),
+	GATE_IMP_IIC_WRAP(CLK_IMPC_AP_CLOCK_RO_I2C11, "impc_ap_i2c11", "i2c_pseudo", 1),
+};
+
+static const struct mtk_gate imp_iic_wrap_e_clks[] = {
+	GATE_IMP_IIC_WRAP(CLK_IMPE_AP_CLOCK_RO_I2C3, "impe_ap_i2c3", "i2c_pseudo", 0),
+};
+
+static const struct mtk_gate imp_iic_wrap_n_clks[] = {
+	GATE_IMP_IIC_WRAP(CLK_IMPN_AP_CLOCK_RO_I2C6, "impn_ap_i2c6", "i2c_pseudo", 0),
+};
+
+static const struct mtk_gate imp_iic_wrap_s_clks[] = {
+	GATE_IMP_IIC_WRAP(CLK_IMPS_AP_CLOCK_RO_I2C8, "imps_ap_i2c8", "i2c_pseudo", 0),
+	GATE_IMP_IIC_WRAP(CLK_IMPS_AP_CLOCK_RO_I2C9, "imps_ap_i2c9", "i2c_pseudo", 1),
+};
+
+static const struct mtk_gate imp_iic_wrap_w_clks[] = {
+	GATE_IMP_IIC_WRAP(CLK_IMPW_AP_CLOCK_RO_I2C0, "impw_ap_i2c0", "i2c_pseudo", 0),
+	GATE_IMP_IIC_WRAP(CLK_IMPW_AP_CLOCK_RO_I2C5, "impw_ap_i2c5", "i2c_pseudo", 1),
+	GATE_IMP_IIC_WRAP(CLK_IMPW_AP_CLOCK_RO_I2C7, "impw_ap_i2c7", "i2c_pseudo", 2),
+};
+
+static const struct mtk_gate imp_iic_wrap_ws_clks[] = {
+	GATE_IMP_IIC_WRAP(CLK_IMPWS_AP_CLOCK_RO_I2C1, "impws_ap_i2c1", "i2c_pseudo", 0),
+	GATE_IMP_IIC_WRAP(CLK_IMPWS_AP_CLOCK_RO_I2C2, "impws_ap_i2c2", "i2c_pseudo", 1),
+	GATE_IMP_IIC_WRAP(CLK_IMPWS_AP_CLOCK_RO_I2C4, "impws_ap_i2c4", "i2c_pseudo", 2),
+};
+
+static const struct mtk_clk_desc imp_iic_wrap_c_desc = {
+	.clks = imp_iic_wrap_c_clks,
+	.num_clks = ARRAY_SIZE(imp_iic_wrap_c_clks),
+};
+
+static const struct mtk_clk_desc imp_iic_wrap_e_desc = {
+	.clks = imp_iic_wrap_e_clks,
+	.num_clks = ARRAY_SIZE(imp_iic_wrap_e_clks),
+};
+
+static const struct mtk_clk_desc imp_iic_wrap_n_desc = {
+	.clks = imp_iic_wrap_n_clks,
+	.num_clks = ARRAY_SIZE(imp_iic_wrap_n_clks),
+};
+
+static const struct mtk_clk_desc imp_iic_wrap_s_desc = {
+	.clks = imp_iic_wrap_s_clks,
+	.num_clks = ARRAY_SIZE(imp_iic_wrap_s_clks),
+};
+
+static const struct mtk_clk_desc imp_iic_wrap_w_desc = {
+	.clks = imp_iic_wrap_w_clks,
+	.num_clks = ARRAY_SIZE(imp_iic_wrap_w_clks),
+};
+
+static const struct mtk_clk_desc imp_iic_wrap_ws_desc = {
+	.clks = imp_iic_wrap_ws_clks,
+	.num_clks = ARRAY_SIZE(imp_iic_wrap_ws_clks),
+};
+
+static const struct of_device_id of_match_clk_mt6833_imp_iic_wrap[] = {
+	{ .compatible = "mediatek,mt6833-imp_iic_wrap_c", .data = &imp_iic_wrap_c_desc },
+	{ .compatible = "mediatek,mt6833-imp_iic_wrap_e", .data = &imp_iic_wrap_e_desc },
+	{ .compatible = "mediatek,mt6833-imp_iic_wrap_n", .data = &imp_iic_wrap_n_desc },
+	{ .compatible = "mediatek,mt6833-imp_iic_wrap_s", .data = &imp_iic_wrap_s_desc },
+	{ .compatible = "mediatek,mt6833-imp_iic_wrap_w", .data = &imp_iic_wrap_w_desc },
+	{ .compatible = "mediatek,mt6833-imp_iic_wrap_ws", .data = &imp_iic_wrap_ws_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6833_imp_iic_wrap);
+
+static struct platform_driver clk_mt6833_imp_iic_wrap_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6833-imp_iic_wrap",
+		.of_match_table = of_match_clk_mt6833_imp_iic_wrap,
+	},
+};
+module_platform_driver(clk_mt6833_imp_iic_wrap_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6833 I2C wrapper clocks driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/input/touchscreen/himax_hx83112f/himax_platform.h b/drivers/input/touchscreen/himax_hx83112f/himax_platform.h
index 84239c711..3e774bd83 100644
--- a/drivers/input/touchscreen/himax_hx83112f/himax_platform.h
+++ b/drivers/input/touchscreen/himax_hx83112f/himax_platform.h
@@ -21,7 +21,7 @@
 extern struct device *g_device;
 
 #define D(x...) dev_dbg(g_device, "[HXTP] " x)
-#define I(x...) dev_info(g_device, "[HXTP] " x)
+#define I(x...) dev_dbg(g_device, "[HXTP] " x)
 #define W(x...) dev_warn(g_device, "[HXTP] " x)
 #define E(x...) dev_err(g_device, "[HXTP] " x)
 #define DIF(x...) \
