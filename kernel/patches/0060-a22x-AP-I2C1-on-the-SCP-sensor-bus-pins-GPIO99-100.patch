From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sun, 4 Oct 2026 10:38:32 +0200
Subject: [PATCH 060/131] a22x: AP I2C1 on the SCP sensor bus pins (GPIO99/100)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts | 29 +++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 9add57176..962b55671 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -200,6 +200,14 @@ pins-owi {
 			};
 		};
 
+		/* vendor routes these to the SCP (SCP_SCL0/SDA0); AP I2C1 on the same pins */
+		i2c1_pins: i2c1-pins {
+			pins-bus {
+				pinmux = <PINMUX_GPIO99__FUNC_SCL1>,
+					 <PINMUX_GPIO100__FUNC_SDA1>;
+			};
+		};
+
 		i2c5_pins: i2c5-pins {
 			pins-bus {
 				pinmux = <PINMUX_GPIO107__FUNC_SCL5>,
@@ -467,12 +475,33 @@ &imp_iic_wrap_w {
 	status = "okay";
 };
 
+&imp_iic_wrap_ws {
+	status = "okay";
+};
+
 / {
 	/*
 	 * I2C5 with the MT6360 sub-PMIC (charger, ADC, LDOs, Type-C). A separate
 	 * node from the stock "i2c5": LK's dtbo overlay rewrites the children of
 	 * the stock one with downstream compatibles. The stock node stays off.
 	 */
+	/* sensor bus: light/proximity and magnetometer, owned by the SCP on stock */
+	i2c1_ml: i2c@11d20000 {
+		compatible = "mediatek,mt6833-i2c", "mediatek,mt8192-i2c";
+		reg = <0 0x11d20000 0 0x1000>,
+		      <0 0x10217100 0 0x80>;
+		interrupts = <0 113 4>;
+		clocks = <&imp_iic_wrap_ws CLK_IMPWS_AP_CLOCK_RO_I2C1>,
+			 <&infracfg_ao CLK_IFRAO_AP_DMA>;
+		clock-names = "main", "dma";
+		clock-div = <1>;
+		clock-frequency = <400000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&i2c1_pins>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+	};
+
 	i2c5_ml: i2c@11e01000 {
 		compatible = "mediatek,mt6833-i2c", "mediatek,mt8192-i2c";
 		reg = <0 0x11e01000 0 0x1000>,
