From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 18:20:51 +0200
Subject: [PATCH 031/131] a22x: CCI DVFS (mtk-cci-devfreq), full LITTLE OPP
 table

- devfreq: mtk-cci: MT6833 platform data
- cpufreq: mediatek: MT6833 coordinates with the CCI (shared Vproc2)
- dts: CCI 450..975 MHz following the vendor B20G CCI map through
  required-opps; LITTLE now scales down to 500 MHz

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts | 129 +++++++++++++++++-
 drivers/cpufreq/mediatek-cpufreq.c            |   5 +-
 drivers/devfreq/mtk-cci-devfreq.c             |  10 ++
 3 files changed, 139 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index ea9939c78..051e07de6 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -602,8 +602,8 @@ opp-955000000 {
  * CPU DVFS: Linux retunes the cluster PLLs itself (mediatek-cpufreq) instead
  * of the vendor CPUHVFS/MCUPM path. Tables are the vendor B20G level that
  * this device is built for (MTK_5GCM_PROJECT), with the unadjusted (pre-EEM)
- * voltages. LITTLE stops at 950 MHz / 0.725 V because the CCI (675 MHz,
- * needs 0.725 V) shares Vproc2 and is not scaled yet.
+ * voltages. The CCI shares Vproc2 with LITTLE and is scaled by
+ * mtk-cci-devfreq from the CPU OPPs' required-opps.
  */
 / {
 	mcusys: syscon@c53a000 {
@@ -612,63 +612,164 @@ mcusys: syscon@c53a000 {
 		#clock-cells = <1>;
 	};
 
+	/* CCI follows the busier cluster (vendor B20G "normal" CCI map) */
+	cci: cci {
+		compatible = "mediatek,mt6833-cci";
+		clocks = <&mcusys CLK_MCU_ARMPLL_BUS_SEL>, <&clk26m>;
+		clock-names = "cci", "intermediate";
+		operating-points-v2 = <&cci_opp>;
+		proc-supply = <&mt6359_vproc2_buck_reg>;
+		sram-supply = <&mt6359_vsram_proc2_ldo_reg>;
+	};
+
+	cci_opp: opp-table-cci {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		cci_opp_450: opp-450000000 {
+			opp-hz = /bits/ 64 <450000000>;
+			opp-microvolt = <650000>;
+		};
+
+		cci_opp_506: opp-506000000 {
+			opp-hz = /bits/ 64 <506000000>;
+			opp-microvolt = <668750>;
+		};
+
+		cci_opp_562: opp-562000000 {
+			opp-hz = /bits/ 64 <562000000>;
+			opp-microvolt = <687500>;
+		};
+
+		cci_opp_618: opp-618000000 {
+			opp-hz = /bits/ 64 <618000000>;
+			opp-microvolt = <706250>;
+		};
+
+		cci_opp_675: opp-675000000 {
+			opp-hz = /bits/ 64 <675000000>;
+			opp-microvolt = <725000>;
+		};
+
+		cci_opp_750: opp-750000000 {
+			opp-hz = /bits/ 64 <750000000>;
+			opp-microvolt = <750000>;
+		};
+
+		cci_opp_825: opp-825000000 {
+			opp-hz = /bits/ 64 <825000000>;
+			opp-microvolt = <775000>;
+		};
+
+		cci_opp_900: opp-900000000 {
+			opp-hz = /bits/ 64 <900000000>;
+			opp-microvolt = <800000>;
+		};
+
+		cci_opp_975: opp-975000000 {
+			opp-hz = /bits/ 64 <975000000>;
+			opp-microvolt = <825000>;
+		};
+	};
+
 	cluster0_opp: opp-table-cluster0 {
 		compatible = "operating-points-v2";
 		opp-shared;
 
