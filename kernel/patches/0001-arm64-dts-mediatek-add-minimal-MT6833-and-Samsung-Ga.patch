+		};
+
+		mt6360_typec: mt6360-typec {
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+
+		mtkfb: mtkfb {
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+
+		mt_pmic_vcamio_ldo_reg: mt-pmic-vcamio-ldo-reg {
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+
+		mt_pmic_vfp_ldo_reg: mt-pmic-vfp-ldo-reg {
+			#address-cells = <1>;
