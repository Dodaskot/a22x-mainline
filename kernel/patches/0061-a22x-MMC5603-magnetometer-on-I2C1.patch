From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sun, 4 Oct 2026 10:54:22 +0200
Subject: [PATCH 061/131] a22x: MMC5603 magnetometer on I2C1

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 962b55671..9f3ad9164 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -500,6 +500,13 @@ i2c1_ml: i2c@11d20000 {
 		pinctrl-0 = <&i2c1_pins>;
 		#address-cells = <1>;
 		#size-cells = <0>;
+
+		/* MN78911 light/proximity sits at 0x46 (no driver yet) */
+
+		magnetometer@30 {
+			compatible = "memsic,mmc5603";
+			reg = <0x30>;
+		};
 	};
 
 	i2c5_ml: i2c@11e01000 {
