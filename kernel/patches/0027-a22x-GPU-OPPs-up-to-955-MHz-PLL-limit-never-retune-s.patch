From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 17:44:40 +0200
Subject: [PATCH 027/131] a22x: GPU OPPs up to 955 MHz (PLL limit); never
 retune shared PLLs via muxes

MFGPLL ignores PCW values above the 955 MHz setting, so the 1000/1068 MHz
vendor OPPs are dropped. The debug trace also showed GPU rate requests
evaluating a new mainpll rate through mfg_ref_sel; fixed dividers of shared
PLLs no longer propagate rate requests (only mfgpll and apll1/2 do).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts |  20 +-
 drivers/clk/mediatek/clk-mt6833.c             | 572 +++++++++---------
 2 files changed, 294 insertions(+), 298 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 5d1ff93ca..66ef2db58 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -373,20 +373,21 @@ rtc {
 			 * Only the GPU rails are described; every other MT6359
 			 * regulator stays as the bootloader configured it.
 			 * vgpu is scaled by the GPU OPP table; vsram_gpu stays
-			 * at the highest SRAM voltage of the vendor table.
+			 * fixed above the highest vendor SRAM voltage used up
+			 * to 955 MHz (0.78125 V).
 			 */
 			regulators {
 				mt6359_vproc1_buck_reg: buck_vproc1 {
 					regulator-name = "vgpu";
 					regulator-min-microvolt = <625000>;
-					regulator-max-microvolt = <850000>;
+					regulator-max-microvolt = <781250>;
 					regulator-enable-ramp-delay = <200>;
 				};
 
 				mt6359_vsram_md_ldo_reg: ldo_vsram_md {
 					regulator-name = "vsram_gpu";
-					regulator-min-microvolt = <850000>;
-					regulator-max-microvolt = <850000>;
+					regulator-min-microvolt = <800000>;
+					regulator-max-microvolt = <800000>;
 					regulator-enable-ramp-delay = <240>;
 				};
 			};
@@ -512,6 +513,9 @@ gpu: gpu@13000000 {
 	/*
 	 * Subset of the Samsung/MediaTek MT6833 GPU table; each voltage is the
 	 * highest of the three chip segments (MT6833, MT6833M, MT6833T).
+	 * The vendor table lists 1000/1068 MHz, but MFGPLL_CON1 ignores any
+	 * PCW above the 955 MHz setting on this chip (Dimensity 700 is rated
+	 * for 950 MHz), so the table stops there.
 	 */
 	gpu_opp_table: opp-table-gpu {
 		compatible = "operating-points-v2";
@@ -549,13 +553,5 @@ opp-955000000 {
 			opp-hz = /bits/ 64 <955000000>;
 			opp-microvolt = <781250>;
 		};
-		opp-1000000000 {
-			opp-hz = /bits/ 64 <1000000000>;
-			opp-microvolt = <800000>;
-		};
-		opp-1068000000 {
-			opp-hz = /bits/ 64 <1068000000>;
-			opp-microvolt = <850000>;
-		};
 	};
 };
