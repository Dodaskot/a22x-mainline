From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 18:40:59 +0200
Subject: [PATCH 037/131] a22x: describe the audio power domain; give vgpu a
 ramp delay

The AFE probe failed attaching to a power domain that had no DT node.
GPU jobs timed out after OPP raises: without a ramp delay the regulator
core switched the clock up before Vgpu had settled.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts      | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 91c27f08e..eaf215730 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -481,6 +481,8 @@ mt6359_vproc1_buck_reg: buck_vproc1 {
 					regulator-name = "vgpu";
 					regulator-min-microvolt = <625000>;
 					regulator-max-microvolt = <781250>;
+					/* MT6359 driver has no slew info; vendor waits ~5 mV/us */
+					regulator-ramp-delay = <5000>;
 					regulator-enable-ramp-delay = <200>;
 				};
 
@@ -586,13 +588,23 @@ scpsys_ml: syscon@10006000 {
 		compatible = "mediatek,mt6833-scpsys", "syscon", "simple-mfd";
 		reg = <0 0x10006000 0 0x1000>;
 
-		/* GPU (MFG) domains only; the others are left to the bootloader. */
+		/* GPU (MFG) and audio domains; the others are left to the bootloader. */
 		spm: power-controller {
 			compatible = "mediatek,mt6833-power-controller";
 			#address-cells = <1>;
 			#size-cells = <0>;
 			#power-domain-cells = <1>;
 
+			power-domain@MT6833_POWER_DOMAIN_AUDIO {
+				reg = <MT6833_POWER_DOMAIN_AUDIO>;
+				clocks = <&topckgen CLK_TOP_AUD_INTBUS_SEL>,
+					 <&infracfg_ao CLK_IFRAO_AUDIO_26M_BCLK>,
+					 <&infracfg_ao CLK_IFRAO_AUDIO>;
+				clock-names = "audio", "audio1", "audio2";
+				mediatek,infracfg = <&infracfg_ao>;
+				#power-domain-cells = <0>;
+			};
+
 			mfg0: power-domain@MT6833_POWER_DOMAIN_MFG0 {
 				reg = <MT6833_POWER_DOMAIN_MFG0>;
 				domain-supply = <&mt6359_vproc1_buck_reg>;
