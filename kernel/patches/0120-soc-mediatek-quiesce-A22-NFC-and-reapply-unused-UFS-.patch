From: Dodaskot <pessdres@gmail.com>
Date: Thu, 8 Oct 2026 16:07:55 +0200
Subject: [PATCH 120/131] soc: mediatek: quiesce A22 NFC and reapply unused UFS
 request cleanup

---
 .../mt6833-samsung-a22x-native-display.dts    |  22 ++
 drivers/soc/mediatek/Kconfig                  |   1 +
 drivers/soc/mediatek/mtk-mt6833-lpm.c         | 252 +++++++++++++++++-
 3 files changed, 261 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts
index 9149e0071..f8be6e421 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts
@@ -55,6 +55,7 @@ lpm_ml: power-controller@c55fce0 {
 			      "boot-ufs-source";
 		/* This eMMC board has no active UFS controller. Gating is opt-in. */
 		mediatek,unused-ufs = <&ufshci>;
+		mediatek,spm = <&scpsys_ml>;
 	};
 
 	mdp_clocks_ml: clock-controller@1f000000 {
@@ -222,3 +223,24 @@ power-domain@6 {
 		#power-domain-cells = <0>;
 	};
 };
+
+/* N5 NFC VEN is active-low (unlike N3). LK leaves it enabled, keeping
+ * GPIO81/SRCLKENAI0 asserted and preventing 26 MHz/INFRA power-off.
+ * Hold NFC off until a native NFC driver takes ownership of both GPIOs.
+ * Do not mask or remux its clock-request input.
+ */
+&pio_ml {
+	nfc-firmware-hog {
+		gpio-hog;
+		gpios = <6 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "nfc-firmware";
+	};
+
+	nfc-enable-hog {
+		gpio-hog;
+		gpios = <7 GPIO_ACTIVE_LOW>;
+		output-low;
+		line-name = "nfc-enable";
+	};
+};
