@@ -54,6 +57,12 @@
 #define MCUPM_EEM_ENABLE_OFFSET	0x4fe
 #define MCUPM_SN_ENABLE_OFFSET	0x4ff
 
+#define UFS_HCE			0x34
+#define UFS_XOUFS_ST		0x144
+#define SPM_SRC_REQ_STA0		0x118
+#define SPM_UFS_REQ_MASK		GENMASK(14, 10)
+#define SPM_UFS_REQ_BOOT		0x2c00
+
 static const char * const boot_peripheral_clock_names[] = {
 	"boot-uart1", "boot-spi0", "boot-spi3", "boot-spi4",
 	"boot-spi5", "boot-spi6", "boot-spi7",
@@ -98,6 +107,16 @@ struct mt6833_lpm {
 	bool ufs_source_sleep_gated;
 	u32 ufs_source_sleep_entries;
 	u32 ufs_source_restore_errors;
+	void __iomem *ufs_regs;
+	struct regmap *spm;
+	bool ufs_request_cleanup;
+	bool ufs_request_fault;
+	u32 ufs_request_saved_xo;
+	u32 ufs_request_last_xo;
+	u32 ufs_request_last_spm;
+	u32 ufs_request_clears;
+	int ufs_request_result;
