diff --git a/drivers/clk/mediatek/clk-mt6833-audsys.c b/drivers/clk/mediatek/clk-mt6833-audsys.c
new file mode 100644
index 000000000..c9548ff44
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6833-audsys.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6833 audio subsystem clock gates.
+ * Gate table from the Samsung SM-A226B (MT6833) kernel source; the AFE
+ * (mediatek,mt6833-audio) is populated as a child, as on MT8192.
+ */
+
+#include <dt-bindings/clock/mt6833-clk.h>
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+static const struct mtk_gate_regs aud0_cg_regs = {
+	.set_ofs = 0x0,
+	.clr_ofs = 0x0,
+	.sta_ofs = 0x0,
+};
+
+static const struct mtk_gate_regs aud1_cg_regs = {
+	.set_ofs = 0x4,
+	.clr_ofs = 0x4,
+	.sta_ofs = 0x4,
+};
+
+static const struct mtk_gate_regs aud2_cg_regs = {
+	.set_ofs = 0x8,
+	.clr_ofs = 0x8,
+	.sta_ofs = 0x8,
+};
+
+#define GATE_AUD0(_id, _name, _parent, _shift)	\
+	GATE_MTK(_id, _name, _parent, &aud0_cg_regs, _shift, &mtk_clk_gate_ops_no_setclr)
+
+#define GATE_AUD1(_id, _name, _parent, _shift)	\
+	GATE_MTK(_id, _name, _parent, &aud1_cg_regs, _shift, &mtk_clk_gate_ops_no_setclr)
+
+#define GATE_AUD2(_id, _name, _parent, _shift)	\
+	GATE_MTK(_id, _name, _parent, &aud2_cg_regs, _shift, &mtk_clk_gate_ops_no_setclr)
+
+static const struct mtk_gate aud_clks[] = {
+	/* AUDSYS0 */
+	GATE_AUD0(CLK_AUDSYS_AFE, "aud_afe", "audio_sel", 2),
+	GATE_AUD0(CLK_AUDSYS_22M, "aud_22m", "aud_engen1_sel", 8),
+	GATE_AUD0(CLK_AUDSYS_24M, "aud_24m", "aud_engen2_sel", 9),
+	GATE_AUD0(CLK_AUDSYS_APLL2_TUNER, "aud_apll2_tuner", "aud_engen2_sel", 18),
+	GATE_AUD0(CLK_AUDSYS_APLL_TUNER, "aud_apll_tuner", "aud_engen1_sel", 19),
+	GATE_AUD0(CLK_AUDSYS_TDM, "aud_tdm_ck", "aud_1_sel", 20),
+	GATE_AUD0(CLK_AUDSYS_ADC, "aud_adc", "audio_sel", 24),
+	GATE_AUD0(CLK_AUDSYS_DAC, "aud_dac", "audio_sel", 25),
+	GATE_AUD0(CLK_AUDSYS_DAC_PREDIS, "aud_dac_predis", "audio_sel", 26),
+	GATE_AUD0(CLK_AUDSYS_TML, "aud_tml", "audio_sel", 27),
+	GATE_AUD0(CLK_AUDSYS_NLE, "aud_nle", "audio_sel", 28),
+	/* AUDSYS1 */
+	GATE_AUD1(CLK_AUDSYS_I2S1_BCLK, "aud_i2s1_bclk", "audio_sel", 4),
+	GATE_AUD1(CLK_AUDSYS_I2S2_BCLK, "aud_i2s2_bclk", "audio_sel", 5),
+	GATE_AUD1(CLK_AUDSYS_I2S3_BCLK, "aud_i2s3_bclk", "audio_sel", 6),
+	GATE_AUD1(CLK_AUDSYS_I2S4_BCLK, "aud_i2s4_bclk", "audio_sel", 7),
+	GATE_AUD1(CLK_AUDSYS_CONNSYS_I2S_ASRC, "aud_connsys_i2s_asrc", "audio_sel", 12),
+	GATE_AUD1(CLK_AUDSYS_GENERAL1_ASRC, "aud_general1_asrc", "audio_sel", 13),
+	GATE_AUD1(CLK_AUDSYS_GENERAL2_ASRC, "aud_general2_asrc", "audio_sel", 14),
+	GATE_AUD1(CLK_AUDSYS_DAC_HIRES, "aud_dac_hires", "audio_h_sel", 15),
+	GATE_AUD1(CLK_AUDSYS_ADC_HIRES, "aud_adc_hires", "audio_h_sel", 16),
+	GATE_AUD1(CLK_AUDSYS_ADC_HIRES_TML, "aud_adc_hires_tml", "audio_h_sel", 17),
+	GATE_AUD1(CLK_AUDSYS_ADDA6_ADC, "aud_adda6_adc", "audio_sel", 20),
+	GATE_AUD1(CLK_AUDSYS_ADDA6_ADC_HIRES, "aud_adda6_adc_hires", "audio_h_sel", 21),
+	GATE_AUD1(CLK_AUDSYS_3RD_DAC, "aud_3rd_dac", "audio_sel", 28),
+	GATE_AUD1(CLK_AUDSYS_3RD_DAC_PREDIS, "aud_3rd_dac_predis", "audio_sel", 29),
+	GATE_AUD1(CLK_AUDSYS_3RD_DAC_TML, "aud_3rd_dac_tml", "audio_sel", 30),
+	GATE_AUD1(CLK_AUDSYS_3RD_DAC_HIRES, "aud_3rd_dac_hires", "audio_h_sel", 31),
+	/* AUDSYS2 */
+	GATE_AUD2(CLK_AUDSYS_I2S5_BCLK, "aud_i2s5_bclk", "audio_sel", 0),
+	GATE_AUD2(CLK_AUDSYS_I2S6_BCLK, "aud_i2s6_bclk", "audio_sel", 1),
+	GATE_AUD2(CLK_AUDSYS_I2S7_BCLK, "aud_i2s7_bclk", "audio_sel", 2),
+	GATE_AUD2(CLK_AUDSYS_I2S8_BCLK, "aud_i2s8_bclk", "audio_sel", 3),
+	GATE_AUD2(CLK_AUDSYS_I2S9_BCLK, "aud_i2s9_bclk", "audio_sel", 4),
+};
+
+static const struct mtk_clk_desc aud_desc = {
+	.clks = aud_clks,
+	.num_clks = ARRAY_SIZE(aud_clks),
+};
+
+static int clk_mt6833_aud_probe(struct platform_device *pdev)
+{
+	int r;
+
+	r = mtk_clk_simple_probe(pdev);
+	if (r)
+		return r;
+
+	r = devm_of_platform_populate(&pdev->dev);
+	if (r)
+		mtk_clk_simple_remove(pdev);
+
+	return r;
+}
+
+static void clk_mt6833_aud_remove(struct platform_device *pdev)
+{
+	of_platform_depopulate(&pdev->dev);
+	mtk_clk_simple_remove(pdev);
+}
+
+static const struct of_device_id of_match_clk_mt6833_aud[] = {
+	{ .compatible = "mediatek,mt6833-audsys", .data = &aud_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6833_aud);
+
+static struct platform_driver clk_mt6833_aud_drv = {
+	.probe = clk_mt6833_aud_probe,
+	.remove = clk_mt6833_aud_remove,
+	.driver = {
+		.name = "clk-mt6833-aud",
+		.of_match_table = of_match_clk_mt6833_aud,
+	},
+};
+module_platform_driver(clk_mt6833_aud_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6833 audio subsystem clocks driver");
+MODULE_LICENSE("GPL");
