From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Tue, 6 Oct 2026 13:47:33 +0200
Subject: [PATCH 096/131] usb: musb: mediatek: gate MT6833 system-sleep clocks
 when USB wake is disabled

---
 drivers/usb/musb/mediatek.c | 39 +++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/drivers/usb/musb/mediatek.c b/drivers/usb/musb/mediatek.c
index c6cbe718b..53c51a5fe 100644
--- a/drivers/usb/musb/mediatek.c
+++ b/drivers/usb/musb/mediatek.c
@@ -50,6 +50,7 @@ struct mtk_glue {
 	struct clk_bulk_data clks[MTK_MUSB_CLKS_NUM];
 	enum usb_role role;
 	struct usb_role_switch *role_sw;
+	bool clks_suspended;
 };
 
 static int mtk_musb_clks_get(struct mtk_glue *glue)
@@ -513,6 +514,43 @@ static void mtk_musb_remove(struct platform_device *pdev)
 	usb_phy_generic_unregister(usb_phy);
 }
 
+static int mtk_musb_suspend_noirq(struct device *dev)
+{
+	struct mtk_glue *glue = dev_get_drvdata(dev);
+
+	if (!of_device_is_compatible(dev->of_node, "mediatek,mt6833-musb"))
+		return 0;
+	/* The child has saved controller context and all device IRQs are
+	 * suspended. Preserve its clock path when USB wake is requested.
+	 */
+	if (device_may_wakeup(&glue->musb_pdev->dev))
+		return 0;
+	clk_bulk_disable_unprepare(MTK_MUSB_CLKS_NUM, glue->clks);
+	glue->clks_suspended = true;
+	dev_dbg(dev, "USB interface clocks gated for system sleep\n");
+	return 0;
+}
+
+static int mtk_musb_resume_noirq(struct device *dev)
+{
+	struct mtk_glue *glue = dev_get_drvdata(dev);
+	int ret;
+
+	if (!glue->clks_suspended)
+		return 0;
+	/* Restore clocks before the child accesses its saved register context. */
+	ret = clk_bulk_prepare_enable(MTK_MUSB_CLKS_NUM, glue->clks);
+	if (ret)
+		return ret;
+	glue->clks_suspended = false;
+	dev_dbg(dev, "USB interface clocks restored after system sleep\n");
+	return 0;
+}
+
+static const struct dev_pm_ops mtk_musb_pm_ops = {
+	NOIRQ_SYSTEM_SLEEP_PM_OPS(mtk_musb_suspend_noirq, mtk_musb_resume_noirq)
+};
+
 #ifdef CONFIG_OF
 static const struct of_device_id mtk_musb_match[] = {
 	{.compatible = "mediatek,mtk-musb",},
@@ -527,6 +565,7 @@ static struct platform_driver mtk_musb_driver = {
 	.driver = {
 		   .name = "musb-mtk",
 		   .of_match_table = of_match_ptr(mtk_musb_match),
+		   .pm = pm_sleep_ptr(&mtk_musb_pm_ops),
 	},
 };
 
