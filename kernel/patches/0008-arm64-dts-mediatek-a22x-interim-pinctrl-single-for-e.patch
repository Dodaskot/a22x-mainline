From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 00:26:31 +0200
Subject: [PATCH 008/131] arm64: dts: mediatek: a22x: interim pinctrl-single
 for eMMC and UART0 pins

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts | 33 +++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 5f5a7c646..b1ec76df8 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -43,6 +43,31 @@ framebuffer@7c9b0000 {
 		};
 	};
 
+	/*
+	 * Interim pin muxing until a mainline MT6833 pinctrl driver exists:
+	 * pinctrl-single writes the 4-bit GPIO mode fields (8 pins per 32-bit
+	 * register, 0x10 stride from 0x10005300). Values match the stock kernel.
+	 */
+	pio_mode: pinctrl@10005300 {
+		compatible = "pinctrl-single";
+		reg = <0 0x10005300 0 0x200>;
+		#pinctrl-cells = <2>;
+		pinctrl-single,bit-per-mux;
+		pinctrl-single,register-width = <32>;
+		pinctrl-single,function-mask = <0xf>;
+
+		/* GPIO61 URXD0, GPIO62 UTXD0: function 1 */
+		uart0_pins: uart0-pins {
+			pinctrl-single,bits = <0x70 0x01100000 0x0ff00000>;
+		};
+
+		/* GPIO65..76 MSDC0 DSL/CLK/CMD/RSTB/DAT0-7: function 1 */
+		mmc0_pins: mmc0-pins {
+			pinctrl-single,bits = <0x80 0x11111110 0xfffffff0>,
+					      <0x90 0x00011111 0x000fffff>;
+		};
+	};
+
 	/*
 	 * Stand-in clocks until there is a mainline MT6833 clock driver.
 	 * Preloader/LK leave these running; rates were measured on the stock
@@ -91,6 +116,9 @@ mmc0: mmc@11230000 {
 		cap-mmc-highspeed;
 		mmc-hs200-1_8v;
 		vmmc-supply = <&reg_vemc>;
+		pinctrl-names = "default", "state_uhs";
+		pinctrl-0 = <&mmc0_pins>;
+		pinctrl-1 = <&mmc0_pins>;
 		non-removable;
 		no-sd;
 		no-sdio;
@@ -132,6 +160,11 @@ watchdog@10007000 {
 	};
 };
 
+&apuart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pins>;
+};
+
 /* The stock fixed clock lacks #clock-cells, so the UART driver cannot use it. */
 &uart_clk {
 	#clock-cells = <0>;
