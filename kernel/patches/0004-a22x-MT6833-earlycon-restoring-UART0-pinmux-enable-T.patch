From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Fri, 2 Oct 2026 23:41:00 +0200
Subject: [PATCH 004/131] a22x: MT6833 earlycon restoring UART0 pinmux, enable
 TOPRGU watchdog

LK/GZ switch GPIO61/62 away from UART0 before jumping to the kernel,
so earlycon output never reached the pads.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts | 10 ++++
 drivers/tty/serial/8250/8250_mt6833_early.c   | 60 +++++++++++++++++++
 drivers/tty/serial/8250/Makefile              |  3 +
 3 files changed, 73 insertions(+)
 create mode 100644 drivers/tty/serial/8250/8250_mt6833_early.c

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 328351e7a..27a4eca6d 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -41,4 +41,14 @@ framebuffer@7c9b0000 {
 			format = "a8r8g8b8";
 		};
 	};
+
+	/*
+	 * LK leaves the TOPRGU watchdog running; let the kernel service it.
+	 * The stock "mediatek,toprgu" node at the same address stays disabled.
+	 */
+	watchdog@10007000 {
+		compatible = "mediatek,mt6833-wdt", "mediatek,mt6589-wdt";
+		reg = <0 0x10007000 0 0x100>;
+		#reset-cells = <1>;
+	};
 };
diff --git a/drivers/tty/serial/8250/8250_mt6833_early.c b/drivers/tty/serial/8250/8250_mt6833_early.c
new file mode 100644
index 000000000..e3386e6b4
--- /dev/null
+++ b/drivers/tty/serial/8250/8250_mt6833_early.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Early console for MediaTek MT6833 boards whose bootloader leaves the AP
+ * UART0 pads (GPIO61 URXD0 / GPIO62 UTXD0) in a non-UART pin function
+ * before jumping to the kernel (seen on Samsung SM-A226B "a22x").
+ *
+ * There is no mainline MT6833 pinctrl driver yet, so the two pin mode
+ * fields are switched back to function 1 (UART0) directly, then the port is
+ * handled by the generic 8250 early console code.
+ *
+ * Usage: earlycon=mt6833uart,0x11002000
+ */
+
+#include <linux/bits.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/serial_8250.h>
+#include <linux/serial_core.h>
+#include <linux/sizes.h>
+#include <asm/early_ioremap.h>
+
+#define MT6833_GPIO_BASE	0x10005000
+#define MT6833_GPIO_MODE7	0x370	/* pins 56..63, 4 bits per pin */
+#define MT6833_URXD0_SHIFT	((61 - 56) * 4)
+#define MT6833_UTXD0_SHIFT	((62 - 56) * 4)
+#define MT6833_FUNC_UART0	1
+
+static void __init mt6833_uart0_pinmux(void)
+{
+	void __iomem *gpio;
+	u32 mask, val;
+
+	gpio = early_ioremap(MT6833_GPIO_BASE, SZ_4K);
+	if (!gpio)
+		return;
+
+	mask = GENMASK(MT6833_URXD0_SHIFT + 3, MT6833_URXD0_SHIFT) |
+	       GENMASK(MT6833_UTXD0_SHIFT + 3, MT6833_UTXD0_SHIFT);
+	val = readl(gpio + MT6833_GPIO_MODE7) & ~mask;
+	val |= MT6833_FUNC_UART0 << MT6833_URXD0_SHIFT;
+	val |= MT6833_FUNC_UART0 << MT6833_UTXD0_SHIFT;
+	writel(val, gpio + MT6833_GPIO_MODE7);
+
+	early_iounmap(gpio, SZ_4K);
+}
+
+static int __init early_mt6833_uart_setup(struct earlycon_device *device,
+					  const char *options)
+{
+	if (!device->port.membase)
+		return -ENODEV;
+
+	mt6833_uart0_pinmux();
+
+	device->port.iotype = UPIO_MEM32;
+	device->port.regshift = 2;
+
+	return early_serial8250_setup(device, NULL);
+}
+EARLYCON_DECLARE(mt6833uart, early_mt6833_uart_setup);
diff --git a/drivers/tty/serial/8250/Makefile b/drivers/tty/serial/8250/Makefile
index 6d21402b4..62a21fb04 100644
--- a/drivers/tty/serial/8250/Makefile
+++ b/drivers/tty/serial/8250/Makefile
@@ -17,6 +17,9 @@ obj-$(CONFIG_SERIAL_8250)		+= 8250_base.o
 8250_base-$(CONFIG_SERIAL_8250_RSA)	+= 8250_rsa.o
 
 obj-$(CONFIG_SERIAL_8250_CONSOLE)	+= 8250_early.o
+ifeq ($(CONFIG_SERIAL_8250_CONSOLE),y)
+obj-$(CONFIG_SERIAL_8250_MT6577)	+= 8250_mt6833_early.o
+endif
 
 obj-$(CONFIG_SERIAL_8250_ACCENT)	+= 8250_accent.o
 obj-$(CONFIG_SERIAL_8250_ACORN)		+= 8250_acorn.o
