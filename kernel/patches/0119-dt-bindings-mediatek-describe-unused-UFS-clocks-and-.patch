From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Thu, 8 Oct 2026 16:07:55 +0200
Subject: [PATCH 119/131] dt-bindings: mediatek: describe unused UFS clocks and
 request status

---
 .../soc/mediatek/mediatek,mt6833-lpm.yaml     | 30 ++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6833-lpm.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6833-lpm.yaml
index 6d9b0dc70..6f013f0b8 100644
--- a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6833-lpm.yaml
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6833-lpm.yaml
@@ -47,9 +47,11 @@ properties:
 
   clocks:
     description: Unused board clocks retained by the bootloader
-    maxItems: 14
+    minItems: 14
+    maxItems: 18
 
   clock-names:
+    minItems: 14
     items:
       - const: boot-uart1
       - const: boot-spi0
@@ -65,6 +67,10 @@ properties:
       - const: boot-mdp-wrot1
       - const: boot-mdp-fake0
       - const: boot-mmpll
+      - const: boot-ufs
+      - const: boot-unipro
+      - const: boot-ufs-bclk
+      - const: boot-ufs-source
 
   mediatek,firmware-config:
     $ref: /schemas/types.yaml#/definitions/phandle
@@ -73,6 +79,28 @@ properties:
       resource-ctrl and constraints lists. This transitional interface
       reuses Samsung's firmware configuration without enabling its driver.
 
+  mediatek,unused-ufs:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Disabled UFS controller on an eMMC board with no UFS device
+
+  mediatek,spm:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: SPM syscon providing read-only unused UFS request status
+
+dependencies:
+  mediatek,spm: [ 'mediatek,unused-ufs' ]
+
+allOf:
+  - if:
+      required:
+        - mediatek,unused-ufs
+    then:
+      properties:
+        clocks:
+          minItems: 18
+        clock-names:
+          minItems: 18
+
 required:
   - compatible
   - reg
