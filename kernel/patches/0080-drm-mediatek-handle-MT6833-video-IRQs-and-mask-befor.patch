From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Mon, 5 Oct 2026 20:21:25 +0200
Subject: [PATCH 080/131] drm/mediatek: handle MT6833 video IRQs and mask
 before domain shutdown

---
 .../mt6833-samsung-a22x-native-display.dts    |  1 +
 drivers/gpu/drm/mediatek/mtk_dsi.c            | 20 +++++++++++++++----
 2 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts
index ba6e609e8..64f654e9d 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts
@@ -1,5 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* Opt-in native display bring-up; the regular a22x DT remains the fallback. */
+#include <dt-bindings/interrupt-controller/arm-gic.h>
 #include "mt6833-samsung-a22x.dts"
 
 / {
diff --git a/drivers/gpu/drm/mediatek/mtk_dsi.c b/drivers/gpu/drm/mediatek/mtk_dsi.c
index 9d7fe577d..b6b246902 100644
--- a/drivers/gpu/drm/mediatek/mtk_dsi.c
+++ b/drivers/gpu/drm/mediatek/mtk_dsi.c
@@ -719,10 +719,16 @@ static irqreturn_t mtk_dsi_irq(int irq, void *dev_id)
 	status = readl(dsi->regs + DSI_INTSTA) & flag;
 
 	if (status) {
-		do {
-			mtk_dsi_mask(dsi, DSI_RACK, RACK, RACK);
-			tmp = readl(dsi->regs + DSI_INTSTA);
-		} while (tmp & DSI_BUSY);
+		if (dsi->driver_data->is_cphy) {
+			/* MT6833's video engine may already be busy with the next frame. */
+			if (status & LPRX_RD_RDY_INT_FLAG)
+				mtk_dsi_mask(dsi, DSI_RACK, RACK, RACK);
+		} else {
+			do {
+				mtk_dsi_mask(dsi, DSI_RACK, RACK, RACK);
+				tmp = readl(dsi->regs + DSI_INTSTA);
+			} while (tmp & DSI_BUSY);
+		}
 
 		mtk_dsi_mask(dsi, DSI_INTSTA, status, 0);
 		mtk_dsi_irq_data_set(dsi, status);
@@ -867,6 +873,12 @@ static void mtk_dsi_poweroff(struct mtk_dsi *dsi)
 
 	mtk_dsi_disable(dsi);
 
+	/* Stop IRQ delivery before the MT6833 display power domain can shut down. */
+	if (dsi->driver_data->is_cphy) {
+		writel(0, dsi->regs + DSI_INTEN);
+		writel(0, dsi->regs + DSI_INTSTA);
+	}
+
 	clk_disable_unprepare(dsi->engine_clk);
 	clk_disable_unprepare(dsi->digital_clk);
 
