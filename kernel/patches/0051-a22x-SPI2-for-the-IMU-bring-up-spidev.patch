From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 23:28:02 +0200
Subject: [PATCH 051/131] a22x: SPI2 for the IMU (bring-up spidev)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 5d882a2eb..16be82ddc 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -215,6 +215,17 @@ pins-cols {
 		};
 
 		/* SD card slot (MSDC1); vendor drive strength 8 mA */
+		/* IMU on SPI2 (the vendor drives it from the SCP via SCP_SPI2) */
+		spi2_pins: spi2-pins {
+			pins-spi {
+				pinmux = <PINMUX_GPIO31__FUNC_SPI2_CLK>,
+					 <PINMUX_GPIO32__FUNC_SPI2_CSB>,
+					 <PINMUX_GPIO33__FUNC_SPI2_MO>,
+					 <PINMUX_GPIO34__FUNC_SPI2_MI>;
+				bias-disable;
+			};
+		};
+
 		mmc1_pins: mmc1-pins {
 			pins-cmd-dat {
 				pinmux = <PINMUX_GPIO126__FUNC_MSDC1_CMD>,
@@ -372,6 +383,25 @@ &uart_clk {
  * adds a "novatek@0" child (compatible list ending in "himax,common"); the
  * properties below are merged into that node.
  */
+&spi2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clocks = <&topckgen CLK_TOP_MAINPLL_D5_D4>,
+		 <&topckgen CLK_TOP_SPI_SEL>,
+		 <&infracfg_ao CLK_IFRAO_SPI2>;
+	clock-names = "parent-clk", "sel-clk", "spi-clk";
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi2_pins>;
+	status = "okay";
+
+	/* bring-up: raw access to identify the IMU */
+	imu@0 {
+		compatible = "rohm,dh2228fv";
+		reg = <0>;
+		spi-max-frequency = <1000000>;
+	};
+};
+
 &spi1 {
 	#address-cells = <1>;
 	#size-cells = <0>;
