From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 18:33:21 +0200
Subject: [PATCH 033/131] a22x: audio pin state labels must not clash with the
 vendor ones

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts | 40 +++++++++----------
 1 file changed, 20 insertions(+), 20 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 569ae30d0..4c5582310 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -100,7 +100,7 @@ pins-reset {
 		};
 
 		/* AFE <-> MT6359 (MTKAIF) and speaker amplifier I2S, vendor states */
-		aud_clk_mosi_off: aud-clk-mosi-off {
+		aud_clk_mosi_off_ml: aud-clk-mosi-off {
 			pins-off {
 				pinmux = <PINMUX_GPIO152__FUNC_GPIO152>,
 					 <PINMUX_GPIO153__FUNC_GPIO153>;
@@ -109,7 +109,7 @@ pins-off {
 			};
 		};
 
-		aud_clk_mosi_on: aud-clk-mosi-on {
+		aud_clk_mosi_on_ml: aud-clk-mosi-on {
 			pins-on {
 				pinmux = <PINMUX_GPIO152__FUNC_AUD_CLK_MOSI>,
 					 <PINMUX_GPIO153__FUNC_AUD_SYNC_MOSI>;
@@ -118,7 +118,7 @@ pins-on {
 			};
 		};
 
-		aud_dat_mosi_off: aud-dat-mosi-off {
+		aud_dat_mosi_off_ml: aud-dat-mosi-off {
 			pins-off {
 				pinmux = <PINMUX_GPIO154__FUNC_GPIO154>,
 					 <PINMUX_GPIO155__FUNC_GPIO155>;
@@ -127,7 +127,7 @@ pins-off {
 			};
 		};
 
-		aud_dat_mosi_on: aud-dat-mosi-on {
+		aud_dat_mosi_on_ml: aud-dat-mosi-on {
 			pins-on {
 				pinmux = <PINMUX_GPIO154__FUNC_AUD_DAT_MOSI0>,
 					 <PINMUX_GPIO155__FUNC_AUD_DAT_MOSI1>;
@@ -136,7 +136,7 @@ pins-on {
 			};
 		};
 
-		aud_dat_miso_off: aud-dat-miso-off {
+		aud_dat_miso_off_ml: aud-dat-miso-off {
 			pins-off {
 				pinmux = <PINMUX_GPIO159__FUNC_GPIO159>,
 					 <PINMUX_GPIO160__FUNC_GPIO160>;
@@ -145,7 +145,7 @@ pins-off {
 			};
 		};
 
-		aud_dat_miso_on: aud-dat-miso-on {
+		aud_dat_miso_on_ml: aud-dat-miso-on {
 			pins-on {
 				pinmux = <PINMUX_GPIO159__FUNC_AUD_DAT_MISO0>,
 					 <PINMUX_GPIO160__FUNC_AUD_DAT_MISO1>;
@@ -154,7 +154,7 @@ pins-on {
 			};
 		};
 
-		aud_gpio_i2s3_off: aud-gpio-i2s3-off {
+		aud_gpio_i2s3_off_ml: aud-gpio-i2s3-off {
 			pins-off {
 				pinmux = <PINMUX_GPIO40__FUNC_GPIO40>,
 					 <PINMUX_GPIO41__FUNC_GPIO41>,
@@ -164,7 +164,7 @@ pins-off {
 			};
 		};
 
-		aud_gpio_i2s3_on: aud-gpio-i2s3-on {
+		aud_gpio_i2s3_on_ml: aud-gpio-i2s3-on {
 			pins-on {
 				pinmux = <PINMUX_GPIO40__FUNC_I2S3_BCK>,
 					 <PINMUX_GPIO41__FUNC_I2S3_LRCK>,
@@ -174,7 +174,7 @@ pins-on {
 			};
 		};
 
-		aud_gpio_i2s0_off: aud-gpio-i2s0-off {
+		aud_gpio_i2s0_off_ml: aud-gpio-i2s0-off {
 			pins-off {
 				pinmux = <PINMUX_GPIO42__FUNC_GPIO42>;
 				input-enable;
@@ -182,7 +182,7 @@ pins-off {
 			};
 		};
 
-		aud_gpio_i2s0_on: aud-gpio-i2s0-on {
+		aud_gpio_i2s0_on_ml: aud-gpio-i2s0-on {
 			pins-on {
 				pinmux = <PINMUX_GPIO42__FUNC_I2S0_DI>;
 				input-schmitt-enable;
@@ -1328,15 +1328,15 @@ sound: sound {
 		compatible = "mediatek,mt6833-mt6359-sound";
 		mediatek,platform = <&afe>;
 		pinctrl-names = "aud_clk_mosi_off", "aud_clk_mosi_on", "aud_dat_mosi_off", "aud_dat_mosi_on", "aud_dat_miso_off", "aud_dat_miso_on", "aud_gpio_i2s3_off", "aud_gpio_i2s3_on", "aud_gpio_i2s0_off", "aud_gpio_i2s0_on";
-			pinctrl-0 = <&aud_clk_mosi_off>;
-			pinctrl-1 = <&aud_clk_mosi_on>;
-			pinctrl-2 = <&aud_dat_mosi_off>;
-			pinctrl-3 = <&aud_dat_mosi_on>;
-			pinctrl-4 = <&aud_dat_miso_off>;
-			pinctrl-5 = <&aud_dat_miso_on>;
-			pinctrl-6 = <&aud_gpio_i2s3_off>;
-			pinctrl-7 = <&aud_gpio_i2s3_on>;
-			pinctrl-8 = <&aud_gpio_i2s0_off>;
-			pinctrl-9 = <&aud_gpio_i2s0_on>;
+			pinctrl-0 = <&aud_clk_mosi_off_ml>;
+			pinctrl-1 = <&aud_clk_mosi_on_ml>;
+			pinctrl-2 = <&aud_dat_mosi_off_ml>;
+			pinctrl-3 = <&aud_dat_mosi_on_ml>;
+			pinctrl-4 = <&aud_dat_miso_off_ml>;
+			pinctrl-5 = <&aud_dat_miso_on_ml>;
+			pinctrl-6 = <&aud_gpio_i2s3_off_ml>;
+			pinctrl-7 = <&aud_gpio_i2s3_on_ml>;
+			pinctrl-8 = <&aud_gpio_i2s0_off_ml>;
+			pinctrl-9 = <&aud_gpio_i2s0_on_ml>;
 	};
 };
