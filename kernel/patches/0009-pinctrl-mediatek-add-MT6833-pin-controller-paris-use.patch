From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 00:55:41 +0200
Subject: [PATCH 009/131] pinctrl: mediatek: add MT6833 pin controller (paris),
 use it on a22x

Pin table and register ranges from the Samsung A226B (MT6833) kernel
source; downstream-only EH/RSEL extensions are left out for now.
Replaces the interim pinctrl-single mux on a22x.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts |   57 +-
 drivers/pinctrl/mediatek/Kconfig              |    7 +
 drivers/pinctrl/mediatek/Makefile             |    1 +
 drivers/pinctrl/mediatek/pinctrl-mt6833.c     | 1207 ++++++++++
 drivers/pinctrl/mediatek/pinctrl-mtk-mt6833.h | 2101 +++++++++++++++++
 include/dt-bindings/pinctrl/mt6833-pinfunc.h  | 1240 ++++++++++
 6 files changed, 4595 insertions(+), 18 deletions(-)
 create mode 100644 drivers/pinctrl/mediatek/pinctrl-mt6833.c
 create mode 100644 drivers/pinctrl/mediatek/pinctrl-mtk-mt6833.h
 create mode 100644 include/dt-bindings/pinctrl/mt6833-pinfunc.h

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index b1ec76df8..d41a2f119 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -16,6 +16,7 @@
 
 /dts-v1/;
 #include <dt-bindings/phy/phy.h>
+#include <dt-bindings/pinctrl/mt6833-pinfunc.h>
 #include "mt6833-samsung-a22x-lk-compat.dtsi"
 
 / {
@@ -43,28 +44,48 @@ framebuffer@7c9b0000 {
 		};
 	};
 
-	/*
-	 * Interim pin muxing until a mainline MT6833 pinctrl driver exists:
-	 * pinctrl-single writes the 4-bit GPIO mode fields (8 pins per 32-bit
-	 * register, 0x10 stride from 0x10005300). Values match the stock kernel.
-	 */
-	pio_mode: pinctrl@10005300 {
-		compatible = "pinctrl-single";
-		reg = <0 0x10005300 0 0x200>;
-		#pinctrl-cells = <2>;
-		pinctrl-single,bit-per-mux;
-		pinctrl-single,register-width = <32>;
-		pinctrl-single,function-mask = <0xf>;
-
-		/* GPIO61 URXD0, GPIO62 UTXD0: function 1 */
+	pio_ml: pinctrl@10005000 {
+		compatible = "mediatek,mt6833-pinctrl";
+		reg = <0 0x10005000 0 0x1000>,
+		      <0 0x11c30000 0 0x1000>,
+		      <0 0x11d10000 0 0x1000>,
+		      <0 0x11d40000 0 0x1000>,
+		      <0 0x11e20000 0 0x1000>,
+		      <0 0x11e60000 0 0x1000>,
+		      <0 0x11ea0000 0 0x1000>,
+		      <0 0x1000b000 0 0x1000>;
+		reg-names = "gpio", "iocfg_rb", "iocfg_bm", "iocfg_br",
+			    "iocfg_lm", "iocfg_bl", "iocfg_rt", "eint";
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&pio_ml 0 0 201>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupts = <0 212 4>;
+
+		/* Mux only; pulls and drive strength stay as the bootloader set them. */
 		uart0_pins: uart0-pins {
-			pinctrl-single,bits = <0x70 0x01100000 0x0ff00000>;
+			pins-rx-tx {
+				pinmux = <PINMUX_GPIO61__FUNC_URXD0>,
+					 <PINMUX_GPIO62__FUNC_UTXD0>;
+			};
 		};
 
-		/* GPIO65..76 MSDC0 DSL/CLK/CMD/RSTB/DAT0-7: function 1 */
 		mmc0_pins: mmc0-pins {
-			pinctrl-single,bits = <0x80 0x11111110 0xfffffff0>,
-					      <0x90 0x00011111 0x000fffff>;
+			pins-bus {
+				pinmux = <PINMUX_GPIO65__FUNC_MSDC0_DSL>,
+					 <PINMUX_GPIO66__FUNC_MSDC0_CLK>,
+					 <PINMUX_GPIO67__FUNC_MSDC0_CMD>,
+					 <PINMUX_GPIO68__FUNC_MSDC0_RSTB>,
+					 <PINMUX_GPIO69__FUNC_MSDC0_DAT0>,
+					 <PINMUX_GPIO70__FUNC_MSDC0_DAT1>,
+					 <PINMUX_GPIO71__FUNC_MSDC0_DAT2>,
+					 <PINMUX_GPIO72__FUNC_MSDC0_DAT3>,
+					 <PINMUX_GPIO73__FUNC_MSDC0_DAT4>,
+					 <PINMUX_GPIO74__FUNC_MSDC0_DAT5>,
+					 <PINMUX_GPIO75__FUNC_MSDC0_DAT6>,
+					 <PINMUX_GPIO76__FUNC_MSDC0_DAT7>;
+			};
 		};
 	};
 
diff --git a/drivers/pinctrl/mediatek/Kconfig b/drivers/pinctrl/mediatek/Kconfig
index 97980cc28..a24fc216d 100644
--- a/drivers/pinctrl/mediatek/Kconfig
+++ b/drivers/pinctrl/mediatek/Kconfig
@@ -266,6 +266,13 @@ config PINCTRL_MT8189
           In MTK platform, we support virtual gpio and use it to
           map specific eint which doesn't have real gpio pin.
 
+config PINCTRL_MT6833
+	bool "MediaTek MT6833 pin control"
+	depends on OF
+	depends on ARM64 || COMPILE_TEST
+	default ARM64 && ARCH_MEDIATEK
+	select PINCTRL_MTK_PARIS
+
 config PINCTRL_MT8192
 	bool "MediaTek MT8192 pin control"
 	depends on OF
