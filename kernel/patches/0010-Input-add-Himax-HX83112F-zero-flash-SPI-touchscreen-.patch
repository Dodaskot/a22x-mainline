+		g_i_FW_VER = (hxfw->data[FW_VER_MAJ_FLASH_ADDR] << 8)
+				| hxfw->data[FW_VER_MIN_FLASH_ADDR];
+#if defined(CONFIG_TOUCHSCREEN_HIMAX_INCELL)
