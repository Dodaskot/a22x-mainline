+static int himax_mcu_cal_data_len(int raw_cnt_rmd, int HX_MAX_PT,
+		int raw_cnt_max)
+{
+	int RawDataLen;
+	/* rawdata checksum is 2 bytes */
+	if (raw_cnt_rmd != 0x00)
+		RawDataLen = MAX_I2C_TRANS_SZ
+			- ((HX_MAX_PT + raw_cnt_max + 3) * 4) - 2;
+	else
