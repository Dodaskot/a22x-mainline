+static int wt_fac_self_test_seq_read(struct seq_file *s, void *v)
+{
+	int ret;
+
+	if (private_ts->suspended == 1) {
+		E("%s: please do self test in active mode\n", __func__);
+		return HX_INIT_FAIL;
+	}
+
+	if (private_ts->in_self_test == 1) {
+		W("%s: Self test is running now!\n", __func__);
+		return ret;
+	}
+
+	private_ts->in_self_test = 1;
+	himax_int_enable(0);/* disable irq */
+	ret = g_core_fp.fp_chip_self_test(NULL, v);
+	himax_int_enable(1);
+	private_ts->in_self_test = 0;
+
+	if (!ret) {
+		seq_printf(s, "%s\n", "result=1");
+	} else {
+		seq_printf(s, "%s\n", "result=0");
+	}
+
+	return 0;
+}
