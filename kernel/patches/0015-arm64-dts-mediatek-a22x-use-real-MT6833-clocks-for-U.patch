From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 01:52:53 +0200
Subject: [PATCH 015/131] arm64: dts: mediatek: a22x: use real MT6833 clocks
 for UART0, SPI1 and USB

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/mediatek/mt6833-samsung-a22x.dts | 35 +++++--------------
 1 file changed, 9 insertions(+), 26 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 31e5701bb..f8e7fc1c2 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -15,6 +15,7 @@
  */
 
 /dts-v1/;
+#include <dt-bindings/clock/mt6833-clk.h>
 #include <dt-bindings/phy/phy.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/irq.h>
@@ -130,30 +131,6 @@ clk_axi: clock-axi {
 		clock-output-names = "standin-axi_ck";
 	};
 
-	clk_usb_top: clock-usb-top {
-		compatible = "fixed-clock";
-		#clock-cells = <0>;
-		clock-frequency = <124800000>;
-		clock-output-names = "standin-fusb_top_ck";
-	};
-
-	clk_spi_parent: clock-spi-parent {
-		compatible = "fixed-clock";
-		#clock-cells = <0>;
-		clock-frequency = <109200000>;
-		clock-output-names = "standin-mainpll_d5_d4";
-	};
-
-	/* mtk-spi re-parents sel-clk onto parent-clk; make that a no-op. */
-	clk_spi_sel: clock-spi-sel {
-		compatible = "fixed-factor-clock";
-		#clock-cells = <0>;
-		clocks = <&clk_spi_parent>;
-		clock-mult = <1>;
-		clock-div = <1>;
-		clock-output-names = "standin-spi_sel";
-	};
-
 	/* VEMC, left enabled by the bootloader for the boot eMMC. */
 	reg_vemc: regulator-vemc {
 		compatible = "regulator-fixed";
@@ -205,7 +182,9 @@ usb_otg: usb@11200000 {
 		interrupt-names = "mc";
 		phys = <&u2port0 PHY_TYPE_USB2>;
 		dr_mode = "peripheral";
-		clocks = <&clk_usb_top>, <&clk_axi>, <&clk_usb_top>;
+		clocks = <&infracfg_ao CLK_IFRAO_SSUSB>,
+			 <&topckgen CLK_TOP_USB_TOP_SEL>,
+			 <&topckgen CLK_TOP_UNIVPLL_D5_D4>;
 		clock-names = "main", "mcu", "univpll";
 	};
 
@@ -221,6 +200,8 @@ watchdog@10007000 {
 };
 
 &apuart0 {
+	clocks = <&uart_clk>, <&infracfg_ao CLK_IFRAO_UART0>;
+	clock-names = "baud", "bus";
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart0_pins>;
 };
@@ -238,7 +219,9 @@ &uart_clk {
 &spi1 {
 	#address-cells = <1>;
 	#size-cells = <0>;
-	clocks = <&clk_spi_parent>, <&clk_spi_sel>, <&clk_spi_sel>;
+	clocks = <&topckgen CLK_TOP_MAINPLL_D5_D4>,
+		 <&topckgen CLK_TOP_SPI_SEL>,
+		 <&infracfg_ao CLK_IFRAO_SPI1>;
 	clock-names = "parent-clk", "sel-clk", "spi-clk";
 	pinctrl-names = "default";
 	pinctrl-0 = <&spi1_pins>;
