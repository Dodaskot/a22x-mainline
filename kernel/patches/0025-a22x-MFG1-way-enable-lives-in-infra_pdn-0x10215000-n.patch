From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sat, 3 Oct 2026 12:54:13 +0200
Subject: [PATCH 025/131] a22x: MFG1 way-enable lives in infra_pdn
 (0x10215000), no ack on close

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts | 9 +++++----
 drivers/pmdomain/mediatek/mt6833-pm-domains.h        | 8 +++++---
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 374980c88..b9e532ff1 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -436,9 +436,10 @@ keypad@10010000 {
 };
 
 / {
-	infracfg_nao: syscon@1020e000 {
-		compatible = "mediatek,mt6833-infracfg-nao", "syscon";
-		reg = <0 0x1020e000 0 0x1000>;
+	/* "infra_pdn" in the vendor kernel: holds the MFG1 AXI way-enable */
+	infra_pdn: syscon@10215000 {
+		compatible = "mediatek,mt6833-infra-pdn", "syscon";
+		reg = <0 0x10215000 0 0x1000>;
 	};
 
 	scpsys_ml: syscon@10006000 {
@@ -466,7 +467,7 @@ mfg1: power-domain@MT6833_POWER_DOMAIN_MFG1 {
 					clock-names = "mfg", "alt";
 					domain-supply = <&mt6359_vsram_md_ldo_reg>;
 					mediatek,infracfg = <&infracfg_ao>;
-					mediatek,infracfg-nao = <&infracfg_nao>;
+					mediatek,infracfg-nao = <&infra_pdn>;
 					#address-cells = <1>;
 					#size-cells = <0>;
 					#power-domain-cells = <1>;
diff --git a/drivers/pmdomain/mediatek/mt6833-pm-domains.h b/drivers/pmdomain/mediatek/mt6833-pm-domains.h
index 5799b4aaf..923ab267f 100644
--- a/drivers/pmdomain/mediatek/mt6833-pm-domains.h
+++ b/drivers/pmdomain/mediatek/mt6833-pm-domains.h
@@ -4,8 +4,9 @@
  *
  * The SPM MFG control/status layout and the MFG1 bus protection masks are
  * the same as MT8192; MT6833 additionally gates the MFG1 AXI "way" in
- * INFRA_NAO (0x1020e000 + 0x4c, bit 11), as done by the Samsung SM-A226B
- * kernel (clk-mt6833-pg.c).
+ * infra_pdn (0x10215000 + 0x4c, bit 11; bit 12 must stay set), as done by
+ * the Samsung SM-A226B kernel (clk-mt6833-pg.c). That register is its own
+ * status: closing the way has no ack, opening it reads back bit 11.
  */
 #ifndef __SOC_MEDIATEK_MT6833_PM_DOMAINS_H
 #define __SOC_MEDIATEK_MT6833_PM_DOMAINS_H
@@ -48,7 +49,8 @@ static const struct scpsys_domain_data scpsys_domain_data_mt6833[] = {
 				      MT6833_INFRA_NAO_MFG1_WAY_EN,
 				      MT6833_INFRA_NAO_MFG1_WAY_EN_MASK,
 				      MT6833_INFRA_NAO_MFG1_WAY_EN,
-				      BUS_PROT_INVERTED | BUS_PROT_REG_UPDATE),
+				      BUS_PROT_INVERTED | BUS_PROT_REG_UPDATE |
+				      BUS_PROT_IGNORE_CLR_ACK),
 			BUS_PROT_WR(INFRA,
 				    MT8192_TOP_AXI_PROT_EN_1_MFG1,
 				    MT8192_TOP_AXI_PROT_EN_1_SET,
