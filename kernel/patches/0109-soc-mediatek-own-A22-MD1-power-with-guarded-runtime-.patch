From: Dodaskot <pessdres@gmail.com>
Date: Tue, 6 Oct 2026 21:48:21 +0200
Subject: [PATCH 109/131] soc: mediatek: own A22 MD1 power with guarded runtime
 parking

---
 .../mt6833-samsung-a22x-native-display.dts    |  12 ++
 drivers/pmdomain/mediatek/mt6833-pm-domains.h |   2 +-
 drivers/soc/mediatek/Kconfig                  |   7 +
 drivers/soc/mediatek/Makefile                 |   1 +
 drivers/soc/mediatek/mtk-mt6833-modem-power.c | 203 ++++++++++++++++++
 5 files changed, 224 insertions(+), 1 deletion(-)
 create mode 100644 drivers/soc/mediatek/mtk-mt6833-modem-power.c

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts
index a36ad2b6f..a2fb2d1e0 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x-native-display.dts
@@ -4,6 +4,13 @@
 #include "mt6833-samsung-a22x.dts"
 
 / {
+	modem_power_ml: modem@10209000 {
+		compatible = "mediatek,mt6833-modem-power";
+		reg = <0 0x10209000 0 0x1000>;
+		power-domains = <&spm MT6833_POWER_DOMAIN_MD1>;
+		mediatek,spm = <&scpsys_ml>;
+		wakeup-source;
+	};
 	/* The stock MCUPM controller stays disabled; this driver owns only
 	 * the platform, LPM and disabled-EEM mailboxes of boot-loaded firmware.
 	 * Reuse the existing reservation: adding a new carveout breaks LK.
@@ -185,6 +192,11 @@ novatek@0 {
 };
 
 &spm {
+	power-domain@7 {
+		reg = <MT6833_POWER_DOMAIN_MD1>;
+		mediatek,infracfg = <&infracfg_ao>;
+		#power-domain-cells = <0>;
+	};
 	power-domain@6 {
 		reg = <MT6833_POWER_DOMAIN_DISP>;
 		clocks = <&topckgen CLK_TOP_DISP_SEL>,
diff --git a/drivers/pmdomain/mediatek/mt6833-pm-domains.h b/drivers/pmdomain/mediatek/mt6833-pm-domains.h
