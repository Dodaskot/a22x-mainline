From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dodaskot <pessdres@gmail.com>
Date: Sun, 4 Oct 2026 11:23:07 +0200
Subject: [PATCH 064/131] a22x: CONN domain has no clock (PMIC_CONN gate is not
 provided)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts | 2 --
 1 file changed, 2 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
index 9318c3562..566eb8504 100644
--- a/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6833-samsung-a22x.dts
@@ -832,8 +832,6 @@ spm: power-controller {
 
 			power-domain@MT6833_POWER_DOMAIN_CONN {
 				reg = <MT6833_POWER_DOMAIN_CONN>;
-				clocks = <&infracfg_ao CLK_IFRAO_PMIC_CONN>;
-				clock-names = "conn";
 				mediatek,infracfg = <&infracfg_ao>;
 				#power-domain-cells = <0>;
 			};
