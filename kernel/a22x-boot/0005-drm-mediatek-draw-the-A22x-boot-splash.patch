diff --git a/drivers/gpu/drm/mediatek/Kconfig b/drivers/gpu/drm/mediatek/Kconfig
index ad8c8b823..a3e4acdd1 100644
--- a/drivers/gpu/drm/mediatek/Kconfig
+++ b/drivers/gpu/drm/mediatek/Kconfig
@@ -21,6 +21,21 @@ config DRM_MEDIATEK
 	  This driver provides kernel mode setting and
 	  buffer management to userspace.
 
+config DRM_MEDIATEK_BOOT_SPLASH
+	bool "Boot logo and progress bar for the A22x recovery"
+	depends on DRM_MEDIATEK && DRM_FBDEV_EMULATION
+	help
+	  Draw the recovery logo and a progress bar into the fbdev buffer as
+	  soon as it exists, until userspace takes the screen over.
+
+config DRM_MEDIATEK_BOOT_SPLASH_SWEEP
+	bool "Boot splash: moving light instead of a progress bar"
+	depends on DRM_MEDIATEK_BOOT_SPLASH
+	help
+	  For the system kernel: a light runs to and fro under the logo for as
+	  long as the boot takes, and the splash ends when a compositor or
+	  greeter becomes DRM master, not after a fixed time.
+
 config DRM_MEDIATEK_DP
 	tristate "DRM DPTX Support for MediaTek SoCs"
 	depends on DRM_MEDIATEK
